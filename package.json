{
  "name": "connectors",
  "version": "1.0.0",
  "private": true,
  "description": "Express TypeScript middleware API for Salesforce and QuickBooks integrations.",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
